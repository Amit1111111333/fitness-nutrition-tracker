<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/gray_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Summary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp" />

    <!-- Daily Goal Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Goal"
            android:textSize="14sp"
            android:textColor="@color/gray" />

        <TextView
            android:id="@+id/dailyGoalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2000 grams"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Food Consumed Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Food Consumed"
            android:textSize="14sp"
            android:textColor="@color/gray" />

        <TextView
            android:id="@+id/foodConsumedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 grams"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Calories Burned Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calories Burned"
            android:textSize="14sp"
            android:textColor="@color/gray" />

        <TextView
            android:id="@+id/caloriesBurnedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 calories"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:spacing="8dp">

        <Button
            android:id="@+id/addFoodBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Food"
            android:textColor="@color/white"
            android:backgroundTint="@color/green" />

        <Button
            android:id="@+id/addBurnBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Exercise"
            android:textColor="@color/white"
            android:backgroundTint="@color/orange" />
    </LinearLayout>

    <Button
        android:id="@+id/viewHistoryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View History"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        android:layout_marginTop="8dp" />

</LinearLayout>
